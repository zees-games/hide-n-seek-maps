; hide-n-seek-maps is data, not a game: the maps game-hide-n-seek reads. It is a Godot project
; only so dot-ci's release can import it and attach the -pack.zip the site publishes as
; gamemann/hide-n-seek-maps, the pack a server owner names in their map config, mounted on
; servers and never sent to a player.

config_version=5

[application]

config/name="hide-n-seek-maps"
config/description="Maps for game-hide-n-seek, as JSON documents."
config/features=PackedStringArray("4.7")
